{
  "manifest_version": 3,
  "name": "ADDISLINE SM",
  "version": "1.0",
  "description": "Protección preventiva de privacidad web.",
  "permissions": [
    "activeTab",
    "storage"
],
  "host_permissions": [
  "https://us-central1-addisline-sm.cloudfunctions.net/*"
],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cookieIntentDictionary.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
