{
  "manifest_version": 3,
  "name": "ADDISLINE SM",
  "version": "1.0",
  "description": "Protección preventiva de privacidad web.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://us-central1-addisline-sm.cloudfunctions.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["cookieIntentDictionary.js", "cmpFingerprint.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
