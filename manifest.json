{
  "manifest_version": 3,
  "name": "ADDISLINE SM",
  "version": "1.0",
  "description": "Proteccion preventiva de privacidad web.",
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "addisline_basic_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"]
    }
  ]
}
